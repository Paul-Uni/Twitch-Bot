{
  "manifest_version": 3,
  "name": "Twitch Giveaway Notifier",
  "version": "1.0",
  "description": "Julias giveaway bot",
  "permissions": ["storage", "notifications"],
  "host_permissions": ["*://*.twitch.tv/*"],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["notify.mp3"],
      "matches": ["*://*.twitch.tv/*"]
    }
  ]
}